package com.senac.api_epi.controllers;

import jakarta.persistence.EntityManager;
import org.springframework.http.HttpStatus;
import org.springframework.transaction.annotation.Transactional;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.server.ResponseStatusException;

import java.time.LocalDate;
import java.util.List;
import java.util.Map;

@RestController
@RequestMapping("/dashboard")
@Transactional(readOnly = true)
public class DashboardController {
    private final EntityManager em;

    public DashboardController(EntityManager em) {
        this.em = em;
    }

    private void verificarAdmin(Long adminId) {
        Long total = em.createQuery("select count(f) from Funcionario f where f.id = :id and upper(trim(f.perfil)) = 'ADMIN'", Long.class)
                .setParameter("id", adminId).getSingleResult();
        if (total == 0) {
            throw new ResponseStatusException(HttpStatus.FORBIDDEN, "Apenas administradores podem consultar o painel");
        }
    }

    private static final String PENDENCIAS = " from Funcionario f, Treinamento t where upper(trim(f.perfil)) <> 'ADMIN' and not exists (select r.id from TreinamentoRealizado r where r.funcionario = f and r.treinamento = t)";

    @GetMapping
    public Map<String, Long> indicadores(@RequestParam Long adminId) {
        verificarAdmin(adminId);
        return Map.of(
                "caVencidos", em.createQuery("select count(e) from Epi e where e.validadeCa < :hoje", Long.class).setParameter("hoje", LocalDate.now()).getSingleResult(),
                "pedidosPendentes", contarStatus("SOLICITADO"),
                "episEmprestados", contarStatus("EMPRESTADO"),
                "treinamentosPendentes", em.createQuery("select count(t)" + PENDENCIAS, Long.class).getSingleResult());
    }

    private Long contarStatus(String status) {
        return em.createQuery("select count(e) from Emprestimo e where e.status = :status", Long.class)
                .setParameter("status", status).getSingleResult();
    }

    @GetMapping("/{indicador}")
    public List<Map<String, Object>> detalhes(@PathVariable String indicador, @RequestParam Long adminId) {
        verificarAdmin(adminId);
        return switch (indicador) {
            case "caVencidos" -> em.createQuery("select e.nome, e.ca, e.validadeCa from Epi e where e.validadeCa < :hoje order by e.validadeCa", Object[].class)
                    .setParameter("hoje", LocalDate.now()).getResultList().stream()
                    .map(r -> linha(r[0], "CA " + r[1] + " • Validade: " + r[2])).toList();
            case "pedidosPendentes", "episEmprestados" -> em.createQuery("select e.epi.nome, e.funcionario.nome, e.dataEmprestimo from Emprestimo e where e.status = :status order by e.id desc", Object[].class)
                    .setParameter("status", indicador.equals("pedidosPendentes") ? "SOLICITADO" : "EMPRESTADO")
                    .getResultList().stream().map(r -> linha(r[0], r[1] + " • Solicitação: " + r[2])).toList();
            case "treinamentosPendentes" -> em.createQuery("select t.titulo, f.nome" + PENDENCIAS + " order by f.nome, t.titulo", Object[].class)
                    .getResultList().stream().map(r -> linha(r[0], r[1])).toList();
            default -> throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Indicador não encontrado");
        };
    }

    private Map<String, Object> linha(Object titulo, Object descricao) {
        return Map.of("titulo", titulo, "descricao", descricao);
    }
}
